    "/voice/v1/statement.pdf.send": {
      "post": {
        "operationId": "statement_pdf_send",
        "summary": "Send the issued statement PDF using the supplied destination.",
        "description": "Exact test-environment contract. Requests use nested data; token, headers, call and aiFlow do not affect fixture selection. No production OAuth step is needed for this mock.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "data": {
                    "type": "object",
                    "properties": {
                      "customerNo": {
                        "oneOf": [
                          {
                            "type": "string"
                          },
                          {
                            "type": "integer"
                          }
                        ],
                        "description": "The IVR-supplied customer number. Numeric and string forms select the same fixture."
                      },
                      "cardNumber": {
                        "type": "string",
                        "description": "cardNumber exactly as cards.list returned it. Never substitute the differently masked balance response or rebuild it from caller digits."
                      },
                      "currencyType": {
                        "type": "string",
                        "enum": [
                          "TL",
                          "USD",
                          "EUR",
                          "GBP"
                        ]
                      },
                      "statementDate": {
                        "type": "string",
                        "pattern": "^\\d{2}\\.\\d{2}\\.\\d{4}$",
                        "description": "Date in dd.MM.yyyy from the service; preserve it exactly."
                      },
                      "emailAddress": {
                        "type": "string",
                        "description": "Destination address. The test service does not check it against the registered address; caller authorization is the assistant policy."
                      }
                    },
                    "required": [
                      "customerNo",
                      "cardNumber",
                      "currencyType",
                      "statementDate",
                      "emailAddress"
                    ]
                  },
                  "call": {
                    "type": "object",
                    "properties": {
                      "ani": {
                        "type": "string"
                      },
                      "lang": {
                        "type": "string",
                        "enum": [
                          "tr"
                        ]
                      }
                    }
                  }
                },
                "required": [
                  "data"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Success requires HTTP200 and result.returnCode == \"1\"; return fixture bodies exactly.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/statement_pdf_send_response"
                }
              }
            }
          },
          "400": {

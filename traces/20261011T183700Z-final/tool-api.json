  "paths": {
    "/voice/v1/cards.list": {
      "post": {
        "operationId": "cards_list",
        "summary": "List eligible cards for the IVR-authenticated customer.",
        "description": "Exact test-environment contract. Requests use nested data; token, headers, call and aiFlow do not affect fixture selection. No production OAuth step is needed for this mock.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "data": {
                    "type": "object",
                    "properties": {
                      "customerNo": {
                        "oneOf": [
                          {
                            "type": "string"
                          },
                          {
                            "type": "integer"
                          }
                        ],
                        "description": "The IVR-supplied customer number. Numeric and string forms select the same fixture."
                      },
                      "aiFlow": {
                        "type": "string",
                        "enum": [
                          "CardOps"
                        ]
                      }
                    },
                    "required": [
                      "customerNo"
                    ]
                  },
                  "call": {
                    "type": "object",
                    "properties": {
                      "ani": {
                        "type": "string"
                      },
                      "lang": {
                        "type": "string",
                        "enum": [
                          "tr"
                        ]
                      }
                    }
                  }
                },
                "required": [
                  "data"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Success requires HTTP200 and result.returnCode == \"1\"; return fixture bodies exactly.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/cards_list_response"
                }
              }
            }
          },
          "400": {
            "description": "INVALID_ARGUMENTS_ERROR: missing/empty required field or no fixture for a service without a404.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "Production gateway token missing/expired. Tokens are not checked in this test environment."
          },
          "404": {
            "description": "FB_IVR_CHANNEL_102 warning.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "FBE00099 technical error.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
